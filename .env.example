# ============================================================
# Variables d'environnement — Backend (Railway)
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS commiter le fichier .env dans git !
# ============================================================

# Base de données MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=gebat_easypaie
DB_PORT=3306

# Port du serveur (Railway le définit automatiquement)
PORT=5000

# ============================================================
# Variables d'environnement — Frontend (Vercel)
# À définir dans les paramètres du projet Vercel
# ============================================================

# URL publique du backend (Railway) — sans slash final
# Exemple : https://gebat-easypaie-production.up.railway.app
VITE_API_URL=http://localhost:5000
