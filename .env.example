# ==========================================
# CONFIGURATION BASE DE DONNÉES (Obligatoire)
# ==========================================
DB_HOST=votre_hote_mysql (ex: hayabusa.proxy.rlwy.net)
DB_PORT=55550
DB_USER=root
DB_PASSWORD=votre_mot_de_passe
DB_NAME=gebat_easypaie

# ==========================================
# SECURITE JWT (Obligatoire)
# ==========================================
# Générez une clé forte (ex: avec `openssl rand -hex 64`)
JWT_SECRET=votre_super_secret_jwt_tres_long_et_complexe

# ==========================================
# SERVEUR (Optionnel)
# ==========================================
PORT=5000
FRONTEND_URL=https://votre-domaine-vercel.app

# ==========================================
# FRONTEND VITE (Obligatoire pour le build)
# ==========================================
VITE_API_URL=https://votre-domaine-railway.app
